# ==========================================
*.db
*.sqlite
*.sqlite3
storage/*.db
storage/*.sqlite
*.xlsx
*.xls
*.csv

# ==========================================
# Pièces comptables & Scans uploadés (Factures patients & fournisseurs)
# ==========================================
input_photos/*
!input_photos/.gitkeep
facture-checker/input_photos/*
!facture-checker/input_photos/.gitkeep

# ==========================================
